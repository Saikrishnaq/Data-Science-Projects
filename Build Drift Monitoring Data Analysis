PSI_WARNING = 0.25

KL_WARNING = 0.50

FREQUENCY_HIGH = 1.50

FREQUENCY_LOW = 0.50


# ================================================================
# 16. HEALTH ENGINE
# ================================================================

def determine_status(row):


    major_drift = (

        row[
            "max_psi"
        ]

        >=

        PSI_WARNING

        or

        row[
            "max_kl"
        ]

        >=

        KL_WARNING
    )


    frequency_problem = (

        row[
            "event_frequency_ratio"
        ]

        >

        FREQUENCY_HIGH

        or

        row[
            "event_frequency_ratio"
        ]

        <

        FREQUENCY_LOW
    )


    minor_drift = (

        row[
            "max_psi"
        ]

        >=

        PSI_NORMAL
    )


    if major_drift:

        return "RETRAIN"


    elif frequency_problem:

        return "WARNING"


    elif minor_drift:

        return "WARNING"


    else:

        return "HEALTHY"


